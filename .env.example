# Copiar a .env o ejecutar scripts/configure_postgres.py.
# La contraseña debe codificarse en URL si contiene caracteres especiales.
ATC_DATABASE_URL=postgresql://postgres:CAMBIAR@127.0.0.1:5432/atc_db
ATC_DATABASE_SCHEMA=atc
# Solo al inicializar cuentas en una instalación nueva:
# ATC_ADMIN_PASSWORD=CAMBIAR
# ATC_MANAGER_PASSWORD=CAMBIAR
